<file path="backend/controllers/api.go">
package controllers

import (
	"fmt"
	"mime/multipart"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"time"

	"valve_database/models"

	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
)

func Ping(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{
		"message": "ping",
	})
}

func CreateValve(db *gorm.DB) gin.HandlerFunc {
	return func(c *gin.Context) {
