{
  "$schema": "https://json-schema.boschrexroth.com/ctrlx-automation/ctrlx-core/apps/package-manifest/package-manifest.v1.6.schema.json",
  "version": "1.0.0",
  "id": "valve-database-app",
  "services": {
    "proxyMapping": [
      {
        "name": "valve-database-app",
        "url": "/valve-database-app/",
        "binding": "unix://{$SNAP_DATA}/package-run/valve-database-app/valve-database-app.sock",
        "restricted": []
      }
    ]
  },
  "menus": {
    "sidebar": [
      {
        "id": "valve-database-app",
        "title": "Valve Database (OPC-UA)",
        "icon": "bosch-ic-worldwideweb",
        "items": [
          {
            "id": "valve-database-app-blank",
            "title": "Valve Database App (New Tab)",
            "target": "_blank",
            "link": "/valve-database-app/",
            "items": []
          },
          {
            "id": "valve-database-app-embedded",
            "title": "Valve Database App (Embedded)",
            "target": "embedded",
            "link": "/valve-database-app/",
            "items": []
          }
        ]
      }
    ],
    "settings": [],
    "overview": [
      {
        "id": "valve-database-app",
        "target": "_blank",
        "title": "Valve Database App (OPC-UA)",
        "icon": "bosch-ic-worldwideweb",
        "link": "/valve-database-app/"
      }
    ]
  }
}
